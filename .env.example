# Supabase (Phase 1: booking requests; Phase 2: products, orders)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key, used by API routes to insert bookings. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2: webshop. Set to "true" to enable add-to-cart and checkout.
NEXT_PUBLIC_COMMERCE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
